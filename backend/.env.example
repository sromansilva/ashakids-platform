# ASHAKids Backend - Variables de entorno de ejemplo
PROJECT_NAME="ASHAKids REST API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000

# Conexión local a PostgreSQL
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="ashakids"
DB_USER="postgres"
DB_PASSWORD="your-local-password"
DB_SSL_ENABLED=false
DATABASE_URL="postgresql://postgres:your-local-password@127.0.0.1:5432/ashakids"

# Parámetros de sesión
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
SESSION_COOKIE_NAME="ashakids_session"

# Opcional: Whisper e IA
OPENAI_API_KEY=
WHISPER_MODEL="whisper-1"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"
