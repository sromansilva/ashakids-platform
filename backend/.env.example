# ASHAKids Backend - Variables de entorno locales de ejemplo (no usar en producción)
PROJECT_NAME="ASHAKids REST API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000

# Conexión local a PostgreSQL (coincide con docker-compose.yml)
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="ashakids"
DB_USER="postgres"
DB_PASSWORD="1234"
DB_SSL_ENABLED=false

# Parámetros de sesión; la aplicación guarda solo el hash del token en PostgreSQL.
SESSION_COOKIE_NAME="ashakids_session"
SESSION_TTL_HOURS=24

# Opcional: Whisper e IA
OPENAI_API_KEY=
WHISPER_MODEL="whisper-1"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"
