# ASHAKids Backend - Variables de entorno de ejemplo
PROJECT_NAME="Ashakids API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
PORT=8000
ENVIRONMENT="development"

# La CA se obtiene del panel oficial. Ruta absoluta o relativa al directorio backend.
DB_SSL_CA_FILE=certs/prod-ca-2021.crt
DB_SSL_LEGACY_CA=false
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=15
DB_POOL_TIMEOUT=10
LOGIN_IP_LIMIT=30
LOGIN_PAIR_LIMIT=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LIMITER_MAX_KEYS=10000
WEB_CONCURRENCY=1
NOTIFICATION_REMINDERS_ENABLED=false

# Zoom Server-to-Server OAuth (solo backend; nunca exponer en frontend)
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_API_BASE_URL=https://api.zoom.us/v2
APPOINTMENT_DURATION_MINUTES=40
ZOOM_MEETING_DURATION_MINUTES=40

# Gmail API OAuth server-side (solo backend; nunca exponer en frontend)
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=ASHAKids
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
PUBLIC_ORIGIN=http://localhost:5174
NEWSLETTER_CONFIRMATION_TTL_HOURS=48
NEWSLETTER_RATE_LIMIT=5
NEWSLETTER_RATE_WINDOW_SECONDS=3600

# Orígenes CORS permitidos (separados por coma o lista JSON)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# Conexión directa a PostgreSQL en Supabase
DB_HOST=aws-1-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-password
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?ssl=require

# Parámetros de sesión
SESSION_COOKIE_NAME="ashakids_session"
SESSION_EXPIRE_HOURS=24

# Supabase URL y anon key (para servicios complementarios si se requieren)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key-placeholder
