# ASHAKids Backend - Variables de entorno de ejemplo
PROJECT_NAME="Ashakids API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
PORT=8000
ENVIRONMENT="development"

# Orígenes CORS permitidos (separados por coma o lista JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Conexión directa a PostgreSQL en Supabase mediante SQLAlchemy 2.x
# Formato: postgresql+asyncpg://[usuario]:[password]@[host]:[puerto]/[dbname]
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Parámetros de sesión
SESSION_COOKIE_NAME="ashakids_session"
SESSION_EXPIRE_HOURS=24

# Supabase URL y anon key (para servicios complementarios si se requieren)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key-placeholder
