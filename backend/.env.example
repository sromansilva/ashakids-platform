# ASHAKids Backend - Variables de entorno de ejemplo
PROJECT_NAME="Ashakids API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
PORT=8000
ENVIRONMENT="development"

# La CA se obtiene del panel oficial. Ruta absoluta o relativa al directorio backend.
# No versionar certificados privados ni .env. El certificado público no contiene contraseña.
DB_SSL_CA_FILE=
# Solo para Supabase Root 2021 sin keyUsage (Python 3.13). Conserva certificado/nombre.
DB_SSL_LEGACY_CA=false
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=15
DB_POOL_TIMEOUT=10
LOGIN_IP_LIMIT=30
LOGIN_PAIR_LIMIT=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LIMITER_MAX_KEYS=10000
WEB_CONCURRENCY=1
# Para production: CORS_ORIGINS con origen HTTPS final, API detrás de HTTPS y proxy
# del mismo sitio. No iniciar múltiples procesos/réplicas con el limitador local.

# Orígenes CORS permitidos (separados por coma o lista JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Conexión directa a PostgreSQL en Supabase mediante SQLAlchemy 2.x
# Runtime B02: credencial exclusiva de FastAPI; propietario/migraciones aparte.
# Pooler de sesión: usuario ashakids_runtime.[project-ref], host/puerto del panel.
# Formato: postgresql+asyncpg://[usuario]:[password]@[host]:[puerto]/[dbname]
DATABASE_URL=postgresql+asyncpg://ashakids_runtime:your-runtime-password@db.your-project-ref.supabase.co:5432/postgres

# Parámetros de sesión
SESSION_COOKIE_NAME="ashakids_session"
SESSION_EXPIRE_HOURS=24

# Supabase URL y anon key (para servicios complementarios si se requieren)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key-placeholder
