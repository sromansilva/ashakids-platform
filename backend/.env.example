# ASHAKids Backend - Variables de entorno locales de ejemplo (no usar en producción)
PROJECT_NAME="ASHAKids REST API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
# Set true when this developer instance points to production: no bootstrap migrations,
# seeds, reminders or HTTP writes. PostgreSQL connections also enforce read-only mode.
DEVELOPMENT_READ_ONLY=false
# For local use against an already migrated deployed database, set true to skip
# automatic migrations, demo seeds and reminder jobs while allowing API writes.
DEVELOPMENT_SKIP_BOOTSTRAP=false
HOST="127.0.0.1"
PORT=8000

# Conexión local a PostgreSQL (coincide con docker-compose.yml)
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_NAME="ashakids"
DB_USER="postgres"
DB_PASSWORD="1234"
DB_SSL_ENABLED=false

# Parámetros de sesión y seguridad de acceso
SESSION_COOKIE_NAME="ashakids_session"
SESSION_TTL_HOURS=3
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=5

# Transcripción de muestras breves mediante el microservicio local Wav2Vec 2.0.
ML_SERVICE_ENABLED=true
ML_SERVICE_URL="http://127.0.0.1:8001"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# Chatbot de WhatsApp (Meta Cloud API) para solicitar acceso familiar. Todo es opcional;
# con WHATSAPP_ENABLED=false el webhook responde 404. El bot solo recoge solicitudes:
# la cuenta se crea unicamente cuando un administrador la aprueba.
# URL del webhook a configurar en Meta (App > WhatsApp > Configuracion), campo "messages":
#   https://<PUBLIC_ORIGIN>/api/v1/whatsapp/webhook
# WHATSAPP_VERIFY_TOKEN es el texto que escribes tu mismo en Meta al verificar el webhook.
# La firma X-Hub-Signature-256 se valida con WHATSAPP_APP_SECRET (sin secreto el POST se rechaza).
# La plantilla opcional avisa fuera de la ventana de 24 h y recibe 2 variables:
# {{1}} nombres y {{2}} correo enmascarado.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_ACTIVACION=
WHATSAPP_TEMPLATE_LANG=es

# Modo prueba de sesiones: permite a terapeutas/admin iniciar una sesion fuera de su horario
# (POST /sesiones/:key/iniciar con {"modo_prueba": true}). Solo para la fase de pruebas.
# Con ENVIRONMENT=production el arranque FALLA si esta activo. No sustituye permisos ni estados.
SESSION_TEST_MODE_ENABLED=false

# Tickets y cuentas de ejemplo para demostraciones locales. Se ignora en producción.
# Sus cuentas tienen contraseña aleatoria: nadie puede iniciar sesión con ellas.
SEED_DEMO_INCIDENCIAS=false
