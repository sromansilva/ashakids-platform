{
  "name": "ashakids-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "npm run test:routing && npm run test:components",
    "test:routing": "node --experimental-strip-types --test tests/routing.test.mjs",
    "test:components": "vitest run",
    "check:frontend": "node scripts/check-frontend.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.9.3",
    "vite": "6.4.4",
    "vitest": "^4.1.11"
  }
}
