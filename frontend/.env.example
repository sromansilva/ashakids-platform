# No secrets in frontend variables. Same-origin cookies work on localhost and 127.0.0.1.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=http://127.0.0.1:8000
# Isolated tests only: explicitly override VITE_DEV_API_TARGET to http://127.0.0.1:8001.
# Production: reverse-proxy /api/v1 to FastAPI over HTTPS (Vite proxy is development-only).
