{
  "info": {
    "name": "ASHAKids QA Smoke",
    "description": "Comprobaciones seguras y de solo lectura para disponibilidad de la API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base_url", "value": "http://127.0.0.1:8000" }],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "header": [], "url": "{{base_url}}/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('status healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
      ] } }]
    },
    {
      "name": "Readiness / database",
      "request": { "method": "GET", "header": [], "url": "{{base_url}}/health/ready" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('database reachable', () => pm.expect(pm.response.json().database).to.eql('reachable'));"
      ] } }]
    },
    {
      "name": "OpenAPI",
      "request": { "method": "GET", "header": [], "url": "{{base_url}}/openapi.json" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
        "pm.test('OpenAPI document', () => pm.expect(pm.response.json().openapi).to.be.a('string'));"
      ] } }]
    }
  ]
}
