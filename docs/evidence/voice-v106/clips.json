    "sha256": "847f96e09ec11c6a3fd6e5da89301a7669e0318406ae4ba89c905f7aeb117f73"
  },
  {
    "file": "f739b740e3fff9c2.mp3",
    "text": "Prepara la merienda sin que falte ni sobre fruta.",
    "bytes": 21600,
    "sha256": "3266902851b1c84246f072c6054b28e1a9b8f056f635e84dcdce36f777d9a6de"
  },
  {
    "file": "b4122eea0fbf5582.mp3",
    "text": "Prepara la merienda sin que falte ni sobre fruta. Mira cuántos amigos vienen. Pon una fruta para cada amigo. Comprueba si todos tienen merienda.",
    "bytes": 69264,
    "sha256": "88caeba6fc9fa67b70a737c45749fb26ed0f5f3d616cba50e51bc8668ea1c4e7"
  },
  {
    "file": "64ceab241543556b.mp3",
    "text": "Ayuda a tu amigo a encontrar su lugar.",
    "bytes": 18720,
    "sha256": "8dd38843a1935a99c7f718877e5bf4200055b3870bfd6b49ab777adfbd322a76"
  },
  {
    "file": "3fb55fcbf74834be.mp3",
    "text": "Ayuda a tu amigo a encontrar su lugar. Escucha dónde quiere estar. Toca un lugar o arrastra a tu amigo. Mira dónde ha quedado.",
