    "sha256": "339cceff86bc6291c68aea4577ace2192948e9df1694c1711c4099fd6ff94971"
  },
  {
    "file": "b0f9af5cdf87a45b.mp3",
    "text": "Explora tres dibujos y di cómo se llaman.",
