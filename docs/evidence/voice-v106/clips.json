    "sha256": "cd1e52a9277d2ea097936d50c89a7ecbf10e99475dae7f511185615a8b257a92"
  },
  {
    "file": "5e6a44a041784c07.mp3",
    "text": "Ayuda a cada dibujo a encontrar su pareja.",
