    "sha256": "866ebef06ea1eeec1129f462f22e0a1b48bdee8abe503cb11afee7ecc49df75c"
  },
  {
    "file": "dd0edd779b3faaae.mp3",
    "text": "Lleva cada dibujo a su familia.",
