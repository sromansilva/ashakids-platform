# Optional: use the EC2 public IPv4 for HTTPS, or a domain you control.
APP_HOST=
# Use "ip" for the EC2 IPv4 or "domain" for a domain name.
TLS_MODE=domain
APP_DB_USER=ashakids_app
APP_DB_PASSWORD=
POSTGRES_PASSWORD=

# Integración opcional de WhatsApp (Meta Cloud API) para solicitudes de acceso familiar.
# Con WHATSAPP_ENABLED=false el webhook responde 404 y no se consumen recursos.
# Requiere dominio propio y TLS_MODE=domain (Meta exige HTTPS con certificado público válido).
# Consulta la guía paso a paso en docs/WhatsApp_Meta_Setup.md.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=<pega-aqui-tu-token-permanente>
WHATSAPP_PHONE_NUMBER_ID=<pega-aqui-tu-phone-number-id>
WHATSAPP_APP_SECRET=<pega-aqui-tu-app-secret>
WHATSAPP_VERIFY_TOKEN=<pega-aqui-tu-verify-token-inventado>
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_ACTIVACION=<pega-aqui-el-nombre-de-tu-plantilla-aprobada>
WHATSAPP_TEMPLATE_LANG=es

