function Isotipo({ size = 36 }: { size?: number }) {
  return (
    <svg width={size} height={size} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="logoGrad" x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
          <stop stopColor="#9F67FA" />
          <stop offset="1" stopColor="#5B21B6" />
        </linearGradient>
      </defs>
      <rect width="40" height="40" rx="13" fill="url(#logoGrad)" />
      {/* Rising spark — three points on a curve: start (child), journey, destination */}
      <circle cx="11" cy="29" r="3" fill="white" />
      <path d="M11 29 Q20.5 21 29 11" stroke="white" strokeWidth="2.5" strokeLinecap="round" fill="none" opacity="0.5" />
      <circle cx="20.5" cy="20" r="2" fill="white" opacity="0.7" />
      <circle cx="29" cy="11" r="3.5" fill="white" />
      {/* Small star at destination */}
      <path d="M29 7.5 L29.6 9.3 L31.5 9.3 L30 10.4 L30.6 12.2 L29 11.1 L27.4 12.2 L28 10.4 L26.5 9.3 L28.4 9.3 Z" fill="white" opacity="0.9" />
    </svg>
  );
}

function IsotipoWhite({ size = 36 }: { size?: number }) {
  return (
    <svg width={size} height={size} viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="40" height="40" rx="13" fill="rgba(255,255,255,0.2)" />
      <circle cx="11" cy="29" r="3" fill="white" />
      <path d="M11 29 Q20.5 21 29 11" stroke="white" strokeWidth="2.5" strokeLinecap="round" fill="none" opacity="0.5" />
      <circle cx="20.5" cy="20" r="2" fill="white" opacity="0.7" />
      <circle cx="29" cy="11" r="3.5" fill="white" />
      <path d="M29 7.5 L29.6 9.3 L31.5 9.3 L30 10.4 L30.6 12.2 L29 11.1 L27.4 12.2 L28 10.4 L26.5 9.3 L28.4 9.3 Z" fill="white" opacity="0.9" />
    </svg>
  );
}

