    { name: "Valentina López",   age: 5, parent: "Rosa López",    therapist: "Dra. Ana Ruiz",       sessions: 6,  status: "activo",      av: "VL", color: B.teal    },
    { name: "Bruno Ríos",        age: 9, parent: "Andrés Ríos",   therapist: "Dra. Ana Ruiz",       sessions: 20, status: "alta próxima", av: "BR", color: "#22C55E" },
    { name: "Fernanda Torres",   age: 6, parent: "Claudia Torres",therapist: "Lic. Carlos Mendoza", sessions: 4,  status: "nuevo",       av: "FT", color: B.orange  },
