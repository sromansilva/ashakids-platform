    { world: "🎵", name: "Montaña Musical",           reason: "Refuerza comprensión verbal",     view: "mundo-asha/canciones"   as View, color: B.violet, bg: B.violetLight },
    { world: "🧩", name: "Valle de Adivinanzas",      reason: "Estimula memoria y lógica",       view: "mundo-asha/adivinanzas" as View, color: B.orange, bg: B.orangeLight },
  ];

