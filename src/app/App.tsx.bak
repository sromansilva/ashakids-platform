                        <p className="text-xs text-[#9E95B7] font-bold mb-0.5">{icon} {lbl}</p>
                        <p className="text-sm font-extrabold text-[#1C1135]">{val}</p>
                      </div>
                    ))}
                  </div>
                  {/* Countdown pill */}
                  <div className="rounded-2xl p-3 flex items-center gap-3 mb-4" style={{ background: B.violetLight }}>
                    <Clock size={16} style={{ color: B.violet }} className="flex-shrink-0" />
