                <h3 className="font-extrabold text-[#1C1135] mb-2">{s.title}</h3>
                <p className="text-sm text-[#7C6F9A] leading-relaxed mb-4 font-medium">{s.desc}</p>
                <span className="text-sm font-bold flex items-center gap-1" style={{ color: s.color }}>
                  Conocer más <ChevronRight size={14} />
                </span>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── How it works ── */}
      <section className="py-20" style={{ background: B.violetLight }}>
        <div className="max-w-7xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-14">
            <Bdg color="violet">¿Cómo funciona?</Bdg>
            <h2 className="mt-4 text-3xl sm:text-4xl font-black text-[#1C1135] tracking-tight">Comenzar es muy sencillo</h2>
          </div>
          <div className="grid md:grid-cols-3 gap-8">
            {steps.map((step, i) => (
              <div key={step.n} className="relative text-center">
                {i < steps.length - 1 && (
                  <div className="hidden md:block absolute top-10 left-[60%] right-0 h-px bg-violet-300 z-0" />
                )}
                <div className="relative z-10 inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white font-black text-violet-700 text-3xl mb-5 shadow-sm shadow-violet-100">
                  {step.icon}
                </div>
                <div className="text-xs font-black text-violet-400 mb-1 tracking-widest uppercase">{step.n}</div>
                <h3 className="font-extrabold text-[#1C1135] text-lg mb-2">{step.title}</h3>
                <p className="text-sm text-[#7C6F9A] leading-relaxed max-w-xs mx-auto font-medium">{step.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── Therapists ── */}
      <section className="py-20" style={{ background: B.bg }}>
        <div className="max-w-7xl mx-auto px-4 sm:px-6">
          <div className="flex items-end justify-between flex-wrap gap-4 mb-10">
            <div>
              <Bdg color="teal">Nuestro Equipo</Bdg>
              <h2 className="mt-3 text-3xl font-black text-[#1C1135] tracking-tight leading-tight">
                Terapeutas certificados<br />y comprometidos
              </h2>
            </div>
            <Btn variant="outline" onClick={() => go("login")} className="hidden md:inline-flex">
              Ver todos <ArrowRight size={14} />
            </Btn>
          </div>
          <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {therapists.slice(0, 3).map(t => (
              <div key={t.id} className="bg-white rounded-3xl border border-[#E8E5F4] p-6 hover:shadow-lg transition-all duration-200">
                <div className="flex items-start gap-4 mb-4">
                  <div className="relative">
                    <Av initials={t.av} color={t.color} size="lg" />
                    <div className={`absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full border-2 border-white ${t.available ? "bg-emerald-400" : "bg-slate-300"}`} />
                  </div>
                  <div>
                    <p className="font-extrabold text-[#1C1135]">{t.name}</p>
                    <p className="text-xs text-[#7C6F9A] font-medium">{t.specialty}</p>
                    <div className="flex items-center gap-1 mt-1">
                      <Star size={12} className="text-amber-400 fill-amber-400" />
                      <span className="text-xs font-black text-[#1C1135]">{t.rating}</span>
                      <span className="text-xs text-[#9E95B7]">({t.reviews})</span>
                    </div>
                  </div>
                </div>
                <div className="flex flex-wrap gap-1 mb-5">
                  {t.tags.map(tag => <Bdg key={tag} color="violet">{tag}</Bdg>)}
                  <Bdg color="gray">{t.experience}</Bdg>
                </div>
                <div className="flex items-center justify-between">
                  <div>
                    <p className="text-xs text-[#9E95B7] font-medium">Desde</p>
                    <p className="font-black text-[#1C1135]">${t.price}/hora</p>
                  </div>
                  <Btn size="sm" variant={t.available ? "primary" : "outline"} disabled={!t.available} onClick={() => go("login")}>
                    {t.available ? "Agendar" : "No disponible"}
                  </Btn>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── Testimonials ── */}
      <section className="py-20" style={{ background: "#F5F3FF" }}>
        <div className="max-w-7xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-12">
            <Bdg color="orange">Testimonios</Bdg>
            <h2 className="mt-4 text-3xl sm:text-4xl font-black text-[#1C1135] tracking-tight">Familias que confían<br />en nosotros</h2>
          </div>
          <div className="grid md:grid-cols-3 gap-5">
            {testimonials.map(t => (
              <div key={t.name} className="bg-white rounded-3xl border border-[#E8E5F4] p-7 flex flex-col gap-4">
                <div className="flex gap-0.5">
                  {Array.from({ length: 5 }).map((_, i) => <Star key={i} size={14} className="text-amber-400 fill-amber-400" />)}
                </div>
                <p className="text-sm text-[#4B4869] leading-relaxed flex-1 font-medium italic">&ldquo;{t.text}&rdquo;</p>
                <div className="flex items-center gap-3 pt-4 border-t border-[#E8E5F4]">
                  <Av initials={t.av} color={t.color} size="sm" />
                  <div>
                    <p className="text-sm font-extrabold text-[#1C1135]">{t.name}</p>
                    <p className="text-xs text-[#9E95B7] font-medium">{t.child}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── FAQ ── */}
      <section className="py-20" style={{ background: B.bg }}>
        <div className="max-w-3xl mx-auto px-4 sm:px-6">
          <div className="text-center mb-10">
            <Bdg color="teal">FAQ</Bdg>
            <h2 className="mt-4 text-3xl font-black text-[#1C1135] tracking-tight">Preguntas frecuentes</h2>
          </div>
          <div className="flex flex-col gap-3">
            {faqs.map((faq, i) => (
              <div key={i} className="bg-white rounded-2xl border border-[#E8E5F4] overflow-hidden">
                <button
                  className="w-full text-left px-6 py-4 flex items-center justify-between gap-4 font-extrabold text-[#1C1135] hover:bg-violet-50 transition-colors text-sm sm:text-base"
                  onClick={() => setFaqOpen(faqOpen === i ? null : i)}>
                  {faq.q}
                  <ChevronDown size={17} className={`text-[#9E95B7] flex-shrink-0 transition-transform duration-200 ${faqOpen === i ? "rotate-180" : ""}`} />
                </button>
                {faqOpen === i && (
                  <div className="px-6 pb-5">
                    <p className="text-sm text-[#7C6F9A] leading-relaxed font-medium">{faq.a}</p>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ── CTA / Newsletter (orange) ── */}
      <section className="py-20" style={{ background: B.bg }}>
        <div className="max-w-7xl mx-auto px-4 sm:px-6">
          <div className="relative rounded-3xl overflow-hidden px-10 sm:px-16 py-14 text-center text-white"
            style={{ background: `linear-gradient(135deg, ${B.orange} 0%, #EA580C 100%)` }}>
            {/* Decorative blobs */}
            <div className="absolute top-0 left-0 w-48 h-48 rounded-full bg-white/10 -translate-x-1/2 -translate-y-1/2" />
            <div className="absolute bottom-0 right-0 w-64 h-64 rounded-full bg-white/10 translate-x-1/3 translate-y-1/3" />
            <div className="relative z-10">
              <h2 className="text-3xl sm:text-4xl font-black mb-4 tracking-tight">¿Listo para comenzar?</h2>
              <p className="text-orange-100 mb-8 max-w-md mx-auto leading-relaxed font-medium">
                Suscribite y recibí consejos semanales de estimulación del lenguaje para tu hijo.
              </p>
              <div className="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
                <input type="email" placeholder="Tu correo electrónico" value={email} onChange={e => setEmail(e.target.value)}
                  className="flex-1 px-5 py-3 rounded-2xl text-[#1C1135] text-sm font-bold focus:outline-none focus:ring-2 focus:ring-white/40 placeholder-[#9E95B7]" />
                <button className="bg-white text-orange-600 font-black px-7 py-3 rounded-2xl hover:bg-orange-50 transition-colors whitespace-nowrap">
                  Suscribirme
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ── Footer (deep violet) ── */}
      <footer style={{ background: B.violetDeep }} className="py-14">
        <div className="max-w-7xl mx-auto px-4 sm:px-6">
          <div className="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
            <div>
              <div className="flex items-center gap-2.5 mb-4">
                <IsotipoWhite size={34} />
                <span className="font-black text-white text-lg">AshaKids</span>
              </div>
              <p className="text-sm text-violet-300 leading-relaxed font-medium">La plataforma de terapia infantil más completa y accesible.</p>
            </div>
            {[
              { title: "Plataforma", links: ["Sobre Nosotros", "Servicios", "Terapeutas", "Actividades"] },
              { title: "Recursos",   links: ["Guía para Padres", "FAQ", "Blog", "Centro de ayuda"]        },
            ].map(col => (
              <div key={col.title}>
                <p className="font-extrabold text-sm text-white mb-4">{col.title}</p>
                <div className="flex flex-col gap-2.5">
                  {col.links.map(l => <a key={l} href="#" className="text-sm text-violet-300 hover:text-white transition-colors font-medium">{l}</a>)}
                </div>
              </div>
            ))}
            <div>
              <p className="font-extrabold text-sm text-white mb-4">Contacto</p>
              <div className="flex flex-col gap-3">
                <a href="#" className="flex items-center gap-2 text-sm text-violet-300 hover:text-white font-medium"><Mail size={14} /> hola@ashakids.com</a>
                <a href="#" className="flex items-center gap-2 text-sm text-violet-300 hover:text-white font-medium"><Phone size={14} /> +54 11 1234-5678</a>
                <a href="#" className="flex items-center gap-2 text-sm text-violet-300 hover:text-white font-medium"><Globe size={14} /> ashakids.com</a>
              </div>
            </div>
          </div>
          <div className="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-violet-400 font-medium">
            <p>© 2026 AshaKids. Todos los derechos reservados.</p>
            <div className="flex gap-5">
              <a href="#" className="hover:text-white transition-colors">Privacidad</a>
              <a href="#" className="hover:text-white transition-colors">Términos</a>
            </div>
          </div>
        </div>
      </footer>
    </div>
  );
}

// ─── Login ─────────────────────────────────────────────────────────────────────

function Login({ go, onLogin }: { go: (v: View) => void; onLogin: (r: Role, v: View) => void }) {
  const [code,    setCode]    = useState("P1234");
  const [pass,    setPass]    = useState("••••");
  const [loading, setLoading] = useState(false);

  const tryLogin = (c: string) => {
    setLoading(true);
    setTimeout(() => {
      setLoading(false);
      if (c.startsWith("A")) onLogin("admin",     "admin");
      else if (c.startsWith("T")) onLogin("terapeuta", "terapeuta");
      else onLogin("padre", "padre");
    }, 700);
  };

  return (
    <div className="min-h-screen flex" style={{ fontFamily: '"Nunito", system-ui, sans-serif' }}>
      {/* Left — brand panel */}
      <div className="hidden lg:flex lg:w-[46%] flex-col items-center justify-center p-14 relative overflow-hidden"
        style={{ background: `linear-gradient(150deg, ${B.violetDeep} 0%, #4C1D95 55%, #5B21B6 100%)` }}>
        {/* Decorative circles */}
        <div className="absolute top-0    left-0    w-80 h-80 rounded-full border border-white/5 -translate-x-1/2 -translate-y-1/2" />
        <div className="absolute bottom-0 right-0   w-96 h-96 rounded-full border border-white/5 translate-x-1/3  translate-y-1/3"  />
        <div className="absolute top-1/2  left-0    w-64 h-64 rounded-full border border-white/5 -translate-x-1/2 -translate-y-1/2" />
        {/* Floating dots */}
        {[[80, 120], [320, 80], [60, 380], [340, 360], [200, 420]].map(([x, y], i) => (
          <div key={i} className="absolute w-2 h-2 rounded-full bg-white/20"
            style={{ left: x, top: y }} />
        ))}
        <div className="relative z-10 text-white text-center w-full">
          <div className="flex items-center justify-center gap-3 mb-12">
            <IsotipoWhite size={44} />
            <span className="font-black text-3xl tracking-tight">AshaKids</span>
          </div>
          <LoginIllustration />
          <h2 className="text-xl font-black mt-6 mb-2 leading-tight">La nueva aventura<br />digital de aprendizaje</h2>
          <p className="text-violet-300 text-sm font-medium">Divertida, dinámica y flexible para toda la familia</p>
        </div>
      </div>

      {/* Right — form */}
      <div className="flex-1 flex flex-col justify-center items-center p-6 sm:p-12 bg-white">
        <div className="w-full max-w-sm">
          <button onClick={() => go("landing")}
            className="flex items-center gap-1.5 text-sm font-bold text-[#7C6F9A] hover:text-violet-700 mb-8 transition-colors group">
            <ChevronLeft size={16} className="group-hover:-translate-x-0.5 transition-transform" /> Volver al inicio
          </button>

          <div className="lg:hidden flex items-center gap-2 mb-8">
            <Isotipo size={32} />
            <span className="font-black text-[#1C1135] text-lg">AshaKids</span>
          </div>

          <h1 className="text-2xl font-black text-[#1C1135] mb-1">Bienvenido de vuelta 👋</h1>
          <p className="text-sm text-[#7C6F9A] font-medium mb-8">Ingresá con tu código ASHA para continuar</p>

          <form className="flex flex-col gap-5" onSubmit={e => { e.preventDefault(); tryLogin(code); }}>
            <Inp label="Código ASHA"  placeholder="P1234" value={code} onChange={setCode} icon={<User size={15} />} hint="Usa el código ASHA proporcionado" />
            <Inp label="Contraseña"   type="password"     placeholder="••••••••" value={pass} onChange={setPass} />
            <div className="flex justify-end -mt-2">
              <a href="#" className="text-sm font-bold text-violet-600 hover:underline">¿Olvidaste tu contraseña?</a>
            </div>
            <button type="submit" disabled={loading}
              className="w-full bg-violet-700 hover:bg-violet-800 disabled:opacity-70 text-white font-black py-3.5 rounded-2xl transition-all duration-200 flex items-center justify-center gap-2 text-sm shadow-sm shadow-violet-200">
              {loading ? <><RefreshCw size={15} className="animate-spin" /> Ingresando...</> : "Iniciar sesión"}
            </button>
          </form>

          <div className="mt-6 p-4 rounded-2xl border border-[#E8E5F4] bg-[#FAFAF9]">
            <p className="text-xs font-extrabold text-[#9E95B7] uppercase tracking-wider mb-3">Acceso rápido de demo</p>
            <div className="flex flex-col gap-1">
              {[
                { label: "Padre / Madre",  code: "P1234", role: "padre"     as Role, view: "padre"     as View, color: B.violet  },
                { label: "Terapeuta",      code: "T0021", role: "terapeuta" as Role, view: "terapeuta" as View, color: B.teal    },
                { label: "Administrador",  code: "A0001", role: "admin"     as Role, view: "admin"     as View, color: B.orange  },
              ].map(d => (
                <button key={d.code}
                  onClick={() => { setCode(d.code); setLoading(true); setTimeout(() => { setLoading(false); onLogin(d.role, d.view); }, 600); }}
                  className="flex items-center justify-between text-xs px-3 py-2.5 rounded-xl hover:bg-white border border-transparent hover:border-[#E8E5F4] transition-all">
                  <span className="font-extrabold text-[#1C1135]">{d.label}</span>
                  <span className="font-black font-mono" style={{ color: d.color }}>{d.code}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

