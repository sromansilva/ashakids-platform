                  <td className="px-5 py-3.5">
                    <span className="text-xs font-bold px-2.5 py-1 rounded-full"
                      style={{ background: p.status === "activo" ? "#D1FAE5" : p.status === "nuevo" ? B.orangeLight : B.tealLight, color: p.status === "activo" ? "#059669" : p.status === "nuevo" ? B.orange : B.teal }}>
                      {p.status}
