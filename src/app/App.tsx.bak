    { icon: "🌿", title: "Rutinas que potencian el aprendizaje", time: "4 min", color: B.teal,   bg: B.tealLight   },
    { icon: "🌞", title: "Manejo del estrés infantil",           time: "3 min", color: B.orange, bg: B.orangeLight },
