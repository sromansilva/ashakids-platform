        <div className="divide-y" style={{ borderColor: B.border }}>
          {transactions.map((t, i) => (
            <div key={i} className="p-4 flex items-center gap-4">
              <Av initials={t.av} color={t.color} size="sm" />
              <div className="flex-1 min-w-0">
