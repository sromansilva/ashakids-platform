          <p className="text-xs font-black text-[#9E95B7] uppercase tracking-widest">Centro Familiar</p>
          <h1 className="text-lg font-black text-[#1C1135] leading-tight">Buenos días, Sergio 👋</h1>
          <p className="text-xs text-[#9E95B7] font-medium">Hoy es un gran día para seguir aprendiendo.</p>
        </div>
        <div className="flex items-center gap-3 flex-shrink-0">
          {/* Child selector */}
